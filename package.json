{
  "name": "geopages",
  "private": true,
  "version": "1.0.0",
  "description": "Programmatic SEO app for local service businesses",
  "scripts": {
    "build": "prisma generate && remix vite:build",
    "dev": "shopify app dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy",
    "start": "prisma migrate deploy && remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "type": "module",
  "engines": { "node": ">=18.20.0" },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.6.0",
    "@shopify/shopify-app-remix": "^3.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.0.4",
    "isbot": "^5.1.6",
    "openai": "^4.55.0",
    "@google/generative-ai": "^0.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "dompurify": "^3.1.6",
    "jsdom": "^24.1.3",
    "papaparse": "^5.4.1",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0",
    "@remix-run/node": "^2.10.0",
    "@remix-run/react": "^2.10.0",
    "@remix-run/serve": "^2.10.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.10.0",
    "@shopify/cli": "^3.66.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.42.0",
    "prisma": "^5.15.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-tsconfig-paths": "^5.0.1"
  }
}
